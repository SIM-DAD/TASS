{
  "//": "Shared compiler options for TASS packages. Plain Node/CommonJS, no UI toolchain. Emit stays ES2019/CommonJS so the built CLI runs on any Node >= 18 without a bundler.",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2019",
    "lib": ["ES2020"],
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "downlevelIteration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  }
}
